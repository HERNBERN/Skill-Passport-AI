# SkillLens AI — ตัวอย่าง environment variables
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (ห้าม commit .env)
# เฉพาะตัวแปรที่ขึ้นต้นด้วย VITE_ เท่านั้นที่ถูกส่งไปฝั่ง browser

# ---------- Client (public) ----------
# Base URL ของ API layer; เว้นว่างไว้เพื่อใช้ server routes ในแอปเดียวกัน
VITE_API_URL=
# URL โปรเจกต์ Supabase เช่น https://xxxx.supabase.co
VITE_SUPABASE_URL=
# publishable / anon key (เปิดเผยได้ ต้องเปิด RLS ทุกตาราง)
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------- Server only (ห้าม prefix VITE_) ----------
# service role key สำหรับงาน admin ที่ข้าม RLS
SUPABASE_SERVICE_ROLE_KEY=
# คีย์ LLM provider สำหรับ AI Skill Extractor
AI_API_KEY=
# ชื่อโมเดลที่ใช้ เช่น google/gemini-2.5-flash
AI_MODEL=
# GitHub personal access token (scope: repo หรือ public_repo) สำหรับวิเคราะห์ repo
GITHUB_TOKEN=
# คีย์บริการ OCR / text extraction สำหรับ PDF และรูปภาพ (ถ้าใช้)
PDF_OCR_API_KEY=
